  "operationSteps": [
    {
      "step": 1,
      "title": "确定旬首",
      "description": "根据当日干支确定所属旬（甲子旬/甲戌旬/甲申旬/甲午旬/甲辰旬/甲寅旬）"
    },
    {
      "step": 2,
      "title": "查找六戊",
      "description": "根据旬首查表得到六戊所在地支（辰/寅/子/戌/申/午）"
    },
    {
      "step": 3,
      "title": "确定方位",
      "description": "六戊地支对应的方位即为结界核心方位"
    },
    {
      "step": 4,
      "title": "画地结界",
      "description": "用刀从鬼门（东北艮位）起，向左画地一周，形成结界"
    },
    {
      "step": 5,
      "title": "取中央土",
      "description": "取中央土一斗，分置于六戊方位上，象征中央戊土镇压四方"
    },
    {
      "step": 6,
      "title": "念咒施法",
      "description": "吸气叩齿七遍，诵读安营咒，完成结界"
    }
  ],
  "relatedSpells": {
    "anYingZhou": {
      "name": "安营咒",
      "content": "太山之阳，常山之阴，盗贼不起，虎狼不行，城郭不完，闭以金关千凶，万恶莫之敢干，仍在营中，宿不复出也。"
    },
    "yuBuZhou": {
      "name": "禹步咒",
      "content": "禹步相催，登阳门。白气混混灌我形。天廻地转，步七星。躡罡步斗，齐九灵。我步我长生。我得我长生。恶逆摧伏，妖邪惊。泉炎消滅，我长生，急急如律令。"
    }
  },
